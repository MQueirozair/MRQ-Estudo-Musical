{
  "name": "mrq-estudo-musical",
  "version": "1.0.0",
  "description": "MRQ Estudo Musical — explorador de acordes, escalas e treino auditivo para piano, 100% offline",
  "author": {
    "name": "MRQ",
    "email": "contato@mrq.com.br"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "electron .",
    "electron:start": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "dist": "npm run electron:check && vite build && electron-builder",
    "dist:all": "npm run electron:check && vite build && electron-builder --win --mac --linux",
    "dist:win": "npm run electron:check && vite build && electron-builder --win",
    "dist:mac": "npm run electron:check && vite build && electron-builder --mac",
    "dist:linux": "npm run electron:check && vite build && electron-builder --linux",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/check.mjs",
    "electron:check": "node scripts/ensure-electron.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "33.4.11",
    "electron-builder": "25.1.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "build": {
    "appId": "br.com.mrq.estudomusical",
    "productName": "MRQ Estudo Musical",
    "copyright": "Copyright © 2026 MRQ",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "compression": "maximum",
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "MRQ-Estudo-Musical-${version}-${arch}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MRQ Estudo Musical",
      "installerLanguages": [
        "pt_BR",
        "es_ES",
        "en_US"
      ],
      "language": "1033"
    },
    "portable": {
      "artifactName": "MRQ-Estudo-Musical-${version}-portable.${ext}"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "MRQ-Estudo-Musical-${version}-${arch}.${ext}",
      "darkModeSupport": true,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Usado para afinação e ditado musical."
      }
    },
    "dmg": {
      "title": "MRQ Estudo Musical ${version}",
      "artifactName": "MRQ-Estudo-Musical-${version}-${arch}.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "AudioVideo;Audio;Education",
      "target": [
        "AppImage",
        "deb"
      ],
      "artifactName": "MRQ-Estudo-Musical-${version}-${arch}.${ext}"
    }
  }
}

# Git LFS tracking for large binary AI models & optional audio datasets
# (Small UI icons in assets/icons/*.png are stored directly in Git for zero-dependency builds)
*.onnx filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.flac filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text

# Line endings consistency
* text=auto
*.sh text eol=lf
*.ps1 text eol=crlf
*.nsi text eol=crlf
*.cpp text eol=lf
*.hpp text eol=lf
*.h text eol=lf
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
